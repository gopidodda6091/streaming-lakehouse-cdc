# Copy to .env and adjust. Placeholders only - never commit real values.
KAFKA_BOOTSTRAP=localhost:19092
TELEMETRY_TOPIC=telemetry
WORKORDER_TOPIC=workorder_cdc
LAKEHOUSE_ROOT=./data/lake
TRIGGER_INTERVAL=30 seconds
MAX_OFFSETS_PER_TRIGGER=20000

# Optional: only for deploying the Databricks bundle (databricks/)
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token-placeholder>
